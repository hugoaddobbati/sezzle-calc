{
  "description": "Shared API contract for POST /api/v1/calculate. The Go API tests send every request and expect exactly this status and response. The frontend tests check that its validation returns the same error (or none) for every case not marked backendOnly, and that its API client reads every response correctly. Change a rule or message here, and both test suites must agree.",
  "cases": [
    {
      "name": "add",
      "request": {
        "number1": "1",
        "operation": "add",
        "number2": "2"
      },
      "status": 200,
      "response": {
        "result": "3",
        "rounded": false
      }
    },
    {
      "name": "add decimals exactly",
      "request": {
        "number1": "0.1",
        "operation": "add",
        "number2": "0.2"
      },
      "status": 200,
      "response": {
        "result": "0.3",
        "rounded": false
      }
    },
    {
      "name": "subtract to negative",
      "request": {
        "number1": "5",
        "operation": "subtract",
        "number2": "8"
      },
      "status": 200,
      "response": {
        "result": "-3",
        "rounded": false
      }
    },
    {
      "name": "multiply beyond float64 precision",
      "request": {
        "number1": "99999999999999999999",
        "operation": "multiply",
        "number2": "99999999999999999999"
      },
      "status": 200,
      "response": {
        "result": "9999999999999999999800000000000000000001",
        "rounded": false
      }
    },
    {
      "name": "divide",
      "request": {
        "number1": "12",
        "operation": "divide",
        "number2": "4"
      },
      "status": 200,
      "response": {
        "result": "3",
        "rounded": false
      }
    },
    {
      "name": "divide terminating",
      "request": {
        "number1": "1",
        "operation": "divide",
        "number2": "8"
      },
      "status": 200,
      "response": {
        "result": "0.125",
        "rounded": false
      }
    },
    {
      "name": "divide rounded down",
      "request": {
        "number1": "1",
        "operation": "divide",
        "number2": "3"
      },
      "status": 200,
      "response": {
        "result": "0.3333333333",
        "rounded": true
      }
    },
    {
      "name": "divide rounded up",
      "request": {
        "number1": "2",
        "operation": "divide",
        "number2": "3"
      },
      "status": 200,
      "response": {
        "result": "0.6666666667",
        "rounded": true
      }
    },
    {
      "name": "chain continues from the rounded value",
      "request": {
        "number1": "0.3333333333",
        "operation": "multiply",
        "number2": "3"
      },
      "status": 200,
      "response": {
        "result": "0.9999999999",
        "rounded": false
      }
    },
    {
      "name": "power",
      "request": {
        "number1": "2",
        "operation": "power",
        "number2": "10"
      },
      "status": 200,
      "response": {
        "result": "1024",
        "rounded": false
      }
    },
    {
      "name": "power negative exponent",
      "request": {
        "number1": "2",
        "operation": "power",
        "number2": "-3"
      },
      "status": 200,
      "response": {
        "result": "0.125",
        "rounded": false
      }
    },
    {
      "name": "power exponent written as decimal",
      "request": {
        "number1": "2",
        "operation": "power",
        "number2": "2.0"
      },
      "status": 200,
      "response": {
        "result": "4",
        "rounded": false
      }
    },
    {
      "name": "power zero to zero",
      "request": {
        "number1": "0",
        "operation": "power",
        "number2": "0"
      },
      "status": 200,
      "response": {
        "result": "1",
        "rounded": false
      }
    },
    {
      "name": "square root",
      "request": {
        "number1": "16",
        "operation": "sqrt"
      },
      "status": 200,
      "response": {
        "result": "4",
        "rounded": false
      }
    },
    {
      "name": "square root rounded",
      "request": {
        "number1": "2",
        "operation": "sqrt"
      },
      "status": 200,
      "response": {
        "result": "1.4142135624",
        "rounded": true
      }
    },
    {
      "name": "square root ignores number2",
      "request": {
        "number1": "9",
        "operation": "sqrt",
        "number2": "not a number"
      },
      "status": 200,
      "response": {
        "result": "3",
        "rounded": false
      }
    },
    {
      "name": "square root of negative zero",
      "request": {
        "number1": "-0",
        "operation": "sqrt"
      },
      "status": 200,
      "response": {
        "result": "0",
        "rounded": false
      }
    },
